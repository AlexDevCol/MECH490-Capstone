<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_hardware</name>
  <version>0.0.0</version>
  <description>ros2_control hardware interface plugin for topic-based communication with ESP32</description>
  <maintainer email="luigi.gonzalez@live.com">MECH490-Capstone Team</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>pluginlib</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <pluginlib pluginname="robot_hardware" plugin="${prefix}/robot_hardware_plugin.xml"/>
  </export>
</package>
